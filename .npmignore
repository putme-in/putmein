# Source code (standalone dist bundles are whitelisted in package.json)
brain/
ray/
cohen/
landing/
scripts/
bin/brain
bin/brain.exe

# Dev configs and agent directories
.git/
.gitignore
.agents/
.claude/
skills-lock.json
install.sh
install.ps1

# Secrets and local runtime states (global wildcard)
.env
.env*
*.env
*.env*
**/.env
**/.env*
**/*.env*
*.log
*.pem
.DS_Store

# Prevent raw source code or configs from ever being packed inside dist/
dist/**/src/
dist/**/app/
dist/**/prisma/
dist/**/scripts/
dist/**/*.ts
dist/**/*.tsx
dist/**/*.map
dist/**/tsconfig*.json
